<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/remote_background"><LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
<ImageButton android:id="@+id/remoteBack" style="@style/RemoteIconButton" android:src="@drawable/remote_ic_back" android:contentDescription="@string/remote_back" />
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="CLIP / RELAY" android:letterSpacing="0.13" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textColor="@color/remote_muted" />
<ImageButton android:id="@+id/settingsButton" style="@style/RemoteIconButton" android:src="@drawable/remote_ic_settings" android:contentDescription="@string/remote_settings" />
<ImageButton android:id="@+id/helpButton" style="@style/RemoteIconButton" android:src="@drawable/remote_ic_help" android:contentDescription="@string/remote_help" />
</LinearLayout><LinearLayout android:id="@+id/remotePageIntro" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp" android:paddingBottom="26dp">
<TextView  style="@style/RemoteTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/remote_connect_title" />
<TextView  style="@style/RemoteBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/remote_connect_subtitle" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="24dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/remote_your_computers" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/remote_ink" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/remote_discovery" android:textSize="12sp" android:textColor="@color/remote_muted" />
</LinearLayout>
<FrameLayout android:id="@+id/pcFragmentContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<RelativeLayout android:id="@+id/no_pc_found_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerInParent="true" android:orientation="vertical" android:gravity="center">
<ImageView android:layout_width="72dp" android:layout_height="72dp" android:padding="19dp" android:background="@drawable/remote_tint" android:src="@drawable/remote_ic_monitor" android:tint="@color/remote_blue" android:importantForAccessibility="no" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="@string/remote_search_title" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="@color/remote_ink" />
<TextView style="@style/RemoteBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="@string/remote_search_body" />
<ProgressBar android:id="@+id/pcs_loading" style="?android:attr/progressBarStyleSmall" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="20dp" android:indeterminateTint="@color/remote_blue" />
</LinearLayout>
</RelativeLayout>
</FrameLayout>
<LinearLayout android:id="@+id/remoteHintCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" android:padding="20dp" android:orientation="horizontal" android:background="@drawable/remote_hint_card">
<ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="14dp" android:src="@drawable/remote_ic_monitor" android:tint="#8DDDD8" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/remote_first_title" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/remote_first_body" android:textSize="12sp" android:lineSpacingExtra="4dp" android:textColor="#BBD1E2" />
</LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginBottom="20dp" android:orientation="horizontal">
<Button android:id="@+id/networkPairPc" style="@style/RemotePrimaryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="10dp" android:text="@string/remote_pair_device" />
<Button android:id="@+id/manuallyAddPc" style="@style/RemotePrimaryButton" android:layout_width="0dp" android:layout_weight="1" android:text="@string/remote_add_address" />
</LinearLayout>
</LinearLayout>
