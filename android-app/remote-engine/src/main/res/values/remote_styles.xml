<resources>
    <style name="RemoteThemeBase" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="RemoteThemeCommon" parent="RemoteThemeBase">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/remote_blue</item>
        <item name="android:windowBackground">@color/remote_background</item>
        <item name="android:colorBackground">@color/remote_background</item>
        <item name="android:statusBarColor">@color/remote_background</item>
        <item name="android:navigationBarColor">@color/remote_background</item>
        <item name="android:textColorPrimary">@color/remote_ink</item>
        <item name="android:textColorSecondary">@color/remote_muted</item>
        <item name="android:windowLightStatusBar">@bool/remote_light_system_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="RemoteTheme" parent="RemoteThemeCommon" />
    <style name="RemoteIconButton">
        <item name="android:layout_width">48dp</item><item name="android:layout_height">48dp</item>
        <item name="android:padding">13dp</item><item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/remote_icon_button</item>
        <item name="android:tint">@color/remote_ink</item>
    </style>
    <style name="RemoteTitle">
        <item name="android:textSize">30sp</item><item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/remote_ink</item><item name="android:includeFontPadding">false</item>
    </style>
    <style name="RemoteBody">
        <item name="android:textSize">14sp</item><item name="android:textColor">@color/remote_muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="RemotePrimaryButton">
        <item name="android:layout_height">52dp</item><item name="android:background">@drawable/remote_primary_button</item>
        <item name="android:backgroundTint">@null</item><item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">20dp</item><item name="android:paddingEnd">20dp</item>
    </style>
</resources>
