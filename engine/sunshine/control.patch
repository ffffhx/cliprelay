   /**
    * @brief Start the HTTPS configuration server.
    */
+  // Private engine extension, available only through Sunshine's existing
+  // administrator authentication. ClipRelay's paired control service filters
+  // streams to the authenticated client; credentials never travel to a phone.
+  const std::string &cliprelayInstance() {
+    static const auto instance = uuid_util::uuid_t::generate().string();
+    return instance;
+  }
+
+  nlohmann::json cliprelayDisplayState() {
+    const auto state = cliprelay::displays.snapshot();
+    nlohmann::json result = {
+      {"protocol", 1}, {"instance", cliprelayInstance()}, {"revision", state.revision}, {"generation", state.generation},
+      {"phase", state.phase}, {"displays", state.displays},
+      {"requestId", state.request_id}, {"requested", state.requested},
+      {"result", state.result}, {"error", state.error}, {"capture", nullptr},
+      {"streams", nlohmann::json::array()}
+    };
+    if (state.capture) {
+      const auto &d = *state.capture;
+      result["capture"] = {{"id", d.id}, {"x", d.x}, {"y", d.y}, {"width", d.width},
+        {"height", d.height}, {"desktopX", d.desktop_x}, {"desktopY", d.desktop_y},
+        {"desktopWidth", d.desktop_width}, {"desktopHeight", d.desktop_height}};
+    }
+    for (const auto &s : state.streams) {
+      result["streams"].push_back({{"owner", s.owner}, {"id", s.id}, {"generation", s.generation},
+        {"width", s.width}, {"height", s.height}, {"firstFrame", s.first_frame}});
+    }
+    return result;
+  }
+
+  void cliprelayDisplays(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request)) return;
+#ifdef _WIN32
+    // EnumOutputs filters detached/non-capturable devices in the same way as
+    // the capture thread. Revalidate by ID there before applying a selection.
+    if (request->query_string == "refresh=1") {
+      cliprelay::displays.catalog(platf::display_names(platf::mem_type_e::dxgi));
+    } else if (!request->query_string.empty()) {
+      bad_request(response, request, "Invalid display query"); return;
+    }
+    send_response(response, cliprelayDisplayState());
+#else
+    send_response(response, {{"protocol", 1}, {"error", "unsupported_platform"}});
+#endif
+  }
+
+  void cliprelaySelectDisplay(const resp_https_t &response, const req_https_t &request) {
+    if (!check_content_type(response, request, "application/json") || !authenticate(response, request)) return;
+    if (!validate_csrf_token(response, request, get_client_id(request))) return;
+    // Bound parsing and reject unknown keys instead of accepting arbitrary
+    // configuration changes through this narrow control endpoint.
+    std::array<char, 1025> body {};
+    request->content.read(body.data(), body.size());
+    const auto length = request->content.gcount();
+    if (length > 1024) { bad_request(response, request, "Request too large"); return; }
+    try {
+      const auto input = nlohmann::json::parse(body.data(), body.data() + length);
+      if (!input.is_object() || input.size() != 3 || !input.contains("display") || !input.contains("revision") || !input.contains("instance") ||
+          !input["display"].is_string() || !input["revision"].is_number_unsigned() || !input["instance"].is_string()) {
+        bad_request(response, request, "Expected display, revision and instance"); return;
+      }
+      const auto id = input["display"].get<std::string>();
+      if (id.empty() || id.size() > 256) { bad_request(response, request, "Invalid display"); return; }
+      const auto outcome = input["instance"].get<std::string>() == cliprelayInstance()
+        ? cliprelay::displays.request(id, input["revision"].get<std::uint64_t>()) : "stale_instance";
+      auto output = cliprelayDisplayState();
+      output["accepted"] = outcome == "accepted";
+      output["outcome"] = outcome;
+      send_response(response, output);
+    } catch (const nlohmann::json::exception &) {
+      bad_request(response, request, "Invalid display request");
+    }
+  }
+
   void start() {
     platf::set_thread_name("confighttp");
     const auto shutdown_event = mail::man->event<bool>(mail::shutdown);
@@ -2354,6 +2429,8 @@ namespace confighttp {
