+        {"requestId", s.request_id}, {"requestedKbps", s.requested}, {"targetVideoKbps", s.target},
+        {"appliedFrame", s.applied_frame}, {"result", s.result}, {"error", s.error}});
+    }
+    return output;
+  }
+
+  void cliprelayBitrate(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request)) return;
