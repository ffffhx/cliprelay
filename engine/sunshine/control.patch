+  const std::string id(32, 'a');
+  const auto fingerprint = pairing_certificate_fingerprint(PUBLIC_CERT);
+  ASSERT_TRUE(register_managed_pairing(id, fingerprint));
+  auto response = std::async(std::launch::async, [this, id]() { return request(server_certificate_target(id) + "&cliprelay_pairing=" + id); });
+  ASSERT_FALSE(wait_for_pending_pairing().empty());
+  for (int attempt = 0; attempt < 3; ++attempt) {
+    std::jthread worker {maintain_pairing_expiry};
+    std::this_thread::sleep_for(std::chrono::milliseconds {30});
+    const auto start = std::chrono::steady_clock::now();
+    worker.request_stop();
+    worker.join();
+    EXPECT_LT(std::chrono::steady_clock::now() - start, std::chrono::milliseconds {750});
+    EXPECT_EQ(response.wait_for(std::chrono::milliseconds {0}), std::future_status::timeout);
+  }
+  EXPECT_TRUE(cancel_managed_pairing(id, fingerprint));
+  EXPECT_NE(response.get().find("status_code=\"400\""), std::string::npos);
+}
+
+TEST_F(ClipRelayManagedPairingTest, WorkerExpiresAbandonedRegistrationAndOnlyExpiredSession) {
+  const std::string abandoned(32, 'c');
+  ASSERT_TRUE(register_managed_pairing(first, fingerprint));
+  ASSERT_TRUE(register_managed_pairing(second, fingerprint));
+  ASSERT_TRUE(register_managed_pairing(abandoned, fingerprint));
+  auto session = managed_session(first);
+  const auto completion = session.completion;
+  std::string expired_id, live_id;
+  ASSERT_EQ(insert_pair_session(std::move(session), expired_id), pair_session_insert_e::ADDED);
+  ASSERT_EQ(insert_pair_session(managed_session(second), live_id), pair_session_insert_e::ADDED);
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds {150};
+  ASSERT_TRUE(nvhttp::test_support::set_managed_pairing_deadline(first, deadline));
+  ASSERT_TRUE(nvhttp::test_support::set_managed_pairing_deadline(abandoned, deadline));
+  std::jthread worker {maintain_pairing_expiry};
+  {
+    std::unique_lock lock {completion->mutex};
+    ASSERT_TRUE(completion->condition.wait_for(lock, std::chrono::seconds {2}, [&] { return completion->result.has_value(); }));
+    EXPECT_FALSE(*completion->result);
+  }
+  // This accessor deliberately has no expiry side effect, unlike GET /api/pin.
+  EXPECT_EQ(nvhttp::test_support::managed_pairing_count(), 1);
+  worker.request_stop();
+  worker.join();
+  const auto pending = get_pending_pairings();
+  ASSERT_EQ(pending.size(), 1);
+  EXPECT_EQ(pending.front().id, live_id);
+}
