     BOOST_LOG(debug) << "Start capturing Video"sv;
+    // Match the authenticated control service's SHA-256(DER certificate) owner.
+    auto cert = crypto::x509(session->client_cert);
+    unsigned char fingerprint[EVP_MAX_MD_SIZE] {};
+    unsigned int fingerprint_length = 0;
+    if (cert && X509_digest(cert.get(), EVP_sha256(), fingerprint, &fingerprint_length) == 1 && fingerprint_length == 32) {
+      constexpr char hex[] = "0123456789abcdef";
+      std::string owner;
+      for (unsigned int i = 0; i < fingerprint_length; ++i) {
+        owner += hex[fingerprint[i] >> 4];
+        owner += hex[fingerprint[i] & 15];
+      }
+      cliprelay::displays.add_stream(session, owner, session->config.monitor.width, session->config.monitor.height);
+    }
+    auto cliprelay_guard = util::fail_guard([&] { cliprelay::displays.remove_stream(session); });
     video::capture(session->mail, session->config.monitor, session);
   }
 
