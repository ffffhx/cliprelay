   namespace {
+    /**
+     * @brief Read the captured display and active desktop in native logical points.
+     * @param id Actual display selected for AVFoundation capture.
+     * @return Geometry only when the selected display is active and representable.
+     */
+    std::optional<cliprelay::display_geometry> capture_geometry(CGDirectDisplayID id) {
+      uint32_t count = 0;
+      if (!CGDisplayIsActive(id) || CGGetActiveDisplayList(0, nullptr, &count) != kCGErrorSuccess || count == 0 || count > 1024) {
+        return std::nullopt;
+      }
+      std::vector<CGDirectDisplayID> active(count);
+      if (CGGetActiveDisplayList(count, active.data(), &count) != kCGErrorSuccess || count == 0) {
+        return std::nullopt;
+      }
+      auto desktop = CGRectNull;
+      bool found = false;
+      for (uint32_t index = 0; index < count; ++index) {
+        found |= active[index] == id;
+        desktop = CGRectUnion(desktop, CGDisplayBounds(active[index]));
+      }
+      if (!found) {
+        return std::nullopt;
+      }
+      const auto selected = CGDisplayBounds(id);
+      return cliprelay::macos::geometry(std::to_string(id), {selected.origin.x, selected.origin.y, selected.size.width, selected.size.height}, {desktop.origin.x, desktop.origin.y, desktop.size.width, desktop.size.height});
+    }
