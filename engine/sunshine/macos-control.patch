+  std::optional<int> cliprelay_state_command(int argc, const char *const *argv, std::ostream &output) {
+    const auto secure_directory = [](std::string_view value) {
+      const fs::path directory {value};
+      struct stat status {};
+      std::error_code error;
+      return lstat(directory.c_str(), &status) == 0 && S_ISDIR(status.st_mode) &&
+             status.st_uid == geteuid() && (status.st_mode & 07777) == 0700 &&
+             fs::canonical(directory, error) == directory && !error;
+    };
+    auto result = cliprelay::macos::state_command(argc, argv, getenv("CLIPRELAY_HOST_STATE_DIR"), secure_directory, output);
+    if (!result) {
+      // Config, logs, certificates and later implicit state share this mode.
+      umask(S_IRWXG | S_IRWXO);
+    }
+    return result;
+  }
