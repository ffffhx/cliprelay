+- (id)initWithOutput:(AVCaptureVideoDataOutput *)output {
+  self = [super init];
+  if (!self) {
+    return nil;
+  }
+  _output = [output retain];
+  _frameLock = [[NSLock alloc] init];
+  _stopLock = [[NSLock alloc] init];
+  _ready = dispatch_semaphore_create(0);
+  dispatch_queue_attr_t qos = dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INITIATED, DISPATCH_QUEUE_PRIORITY_HIGH);
+  _queue = dispatch_queue_create("cliprelay.video.frames", qos);
+  [_output setSampleBufferDelegate:self queue:_queue];
+  return self;
+}
+
+- (void)captureOutput:(AVCaptureOutput *)captureOutput
+  didOutputSampleBuffer:(CMSampleBufferRef)sampleBuffer
+         fromConnection:(AVCaptureConnection *)connection {
+  if (!sampleBuffer || !CMSampleBufferIsValid(sampleBuffer) || !CMSampleBufferGetImageBuffer(sampleBuffer)) {
+    return;
+  }
+  [_frameLock lock];
+  CMSampleBufferRef old = NULL;
+  if (!_stopped) {
+    old = _sample;
+    _sample = (CMSampleBufferRef) CFRetain(sampleBuffer);
+    if (!old) {
+      dispatch_semaphore_signal(_ready);
+    }
+  }
+  [_frameLock unlock];
+  if (old) {
+    CFRelease(old);
+  }
+}
+
+- (CMSampleBufferRef)copyNextFrameBefore:(dispatch_time_t)deadline {
+  [_frameLock lock];
+  BOOL stopped = _stopped;
+  [_frameLock unlock];
+  if (stopped || dispatch_semaphore_wait(_ready, deadline) != 0) {
+    return NULL;
+  }
+  [_frameLock lock];
+  CMSampleBufferRef result = _sample;
+  _sample = NULL;
+  [_frameLock unlock];
+  return result;
+}
+
+- (void)stop {
+  [_stopLock lock];
+  [_frameLock lock];
+  if (!_stopped) {
+    _stopped = YES;
+    dispatch_semaphore_signal(_ready);
+  }
+  CMSampleBufferRef old = _sample;
+  _sample = NULL;
+  [_frameLock unlock];
+  [_output setSampleBufferDelegate:nil queue:nil];
+  // The callback never calls stop or waits for its owner. Once this barrier
+  // finishes, no callback can retain another frame or touch released state.
+  if (_queue) {
+    dispatch_sync(_queue, ^ {});
+  }
+  if (old) {
+    CFRelease(old);
+  }
+  [_stopLock unlock];
+}
+
+- (void)dealloc {
+  [self stop];
+  [_output release];
+  [_frameLock release];
+  [_stopLock release];
+  if (_ready) {
+    dispatch_release(_ready);
+  }
+  if (_queue) {
+    dispatch_release(_queue);
+  }
+  [super dealloc];
+}
+
