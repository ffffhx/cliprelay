+    const auto reply = client->request("POST", "/privacy-test", request.dump(), headers);
+    ASSERT_EQ(reply->status_code, "200 OK");
+    const auto state = nlohmann::json::parse(reply->content.string());
+    EXPECT_EQ(state.at("outcome"), "stale_instance"); EXPECT_EQ(state.at("epoch"), before.at("epoch"));
+    EXPECT_EQ(state.at("retained"), false); EXPECT_EQ(state.at("authorized"), false); EXPECT_EQ(state.at("ready"), false);
