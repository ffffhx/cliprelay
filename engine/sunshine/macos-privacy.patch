+  ASSERT_EQ(initial->status_code, "200 OK");
+  const auto before = nlohmann::json::parse(initial->content.string());
+  EXPECT_EQ(before.at("retained"), false); EXPECT_EQ(before.at("ready"), false);
+  for (const auto &op : {"status", "renew", "release", "prepare"}) {
+    auto request = nlohmann::json {{"op", op}, {"instance", "stale"}, {"owner", std::string(64, 'a')},
