+TEST_F(ConfigHttpTest, ClipRelayPrivacyRejectsMalformedAndDuplicateIdentities) {
+  SimpleWeb::CaseInsensitiveMultimap headers;
+  headers.emplace("Content-Type", "application/json");
+  headers.emplace("Authorization", create_auth_header("testuser", "testpass"));
+  auto request = nlohmann::json {{"op", "prepare"}, {"instance", "stale"}, {"owner", std::string(64, 'a')},
+    {"stream", 1}, {"lease", std::string(32, 'b')}, {"worker", {{"pid", 2}, {"birthSec", 1}, {"birthUsec", 0},
+      {"windows", nlohmann::json::array({{{"id", 1}, {"display", 1}}})}}}};
+  std::vector<std::string> invalid {"{}", std::string(4097, 'a'), "[]", request.dump() + "{}"};
+  for (const auto &field : {"owner", "stream", "lease", "worker", "instance"}) {
+    auto changed = request; changed[field] = false; invalid.push_back(changed.dump());
+  }
+  auto changed = request; changed["extra"] = 1; invalid.push_back(changed.dump());
+  changed = request; changed["stream"] = (1ULL << 53); invalid.push_back(changed.dump());
+  changed = request; changed["worker"]["birthUsec"] = 1000000; invalid.push_back(changed.dump());
+  changed = request; changed["worker"]["windows"].push_back(changed["worker"]["windows"][0]); invalid.push_back(changed.dump());
+  auto duplicate = request.dump(); duplicate.insert(1, "\"op\":\"status\","); invalid.push_back(duplicate);
+  duplicate = request.dump(); duplicate.insert(duplicate.find("\"pid\""), "\"pid\":3,"); invalid.push_back(duplicate);
+  for (const auto &body : invalid) {
+    EXPECT_EQ(client->request("POST", "/privacy-test", body, headers)->status_code, "400 Bad Request") << body;
+  }
