+  void cliprelayPrivacy(const resp_https_t &response, const req_https_t &request) {
+    if (!authenticate(response, request)) return;
+    if (!request->query_string.empty()) { bad_request(response, request, "Invalid privacy query"); return; }
+    if (request->method == "GET") { send_response(response, cliprelayPrivacyState()); return; }
+    if (!check_content_type(response, request, "application/json") || !validate_csrf_token(response, request, get_client_id(request))) return;
+    std::array<char, 4097> body {};
+    request->content.read(body.data(), body.size());
+    const auto length = request->content.gcount();
+    if (length > 4096) { bad_request(response, request, "Request too large"); return; }
+    try {
+      std::vector<std::set<std::string>> keys;
+      const auto input = nlohmann::json::parse(body.data(), body.data() + length, [&](int, nlohmann::json::parse_event_t event, nlohmann::json &value) {
+        if (event == nlohmann::json::parse_event_t::object_start) keys.emplace_back();
+        else if (event == nlohmann::json::parse_event_t::key && !keys.back().insert(value.get<std::string>()).second) throw std::invalid_argument("duplicate");
+        else if (event == nlohmann::json::parse_event_t::object_end) keys.pop_back();
+        return true;
+      });
+      if (!input.is_object() || !input.contains("op") || !input["op"].is_string()) throw std::invalid_argument("op");
+      const auto op = input["op"].get<std::string>();
+      if (op != "prepare" && op != "status" && op != "renew" && op != "release") throw std::invalid_argument("op");
+      if (input.size() != (op == "prepare" ? 6 : 5) || !input.contains("instance") || !input["instance"].is_string() ||
+          !input.contains("owner") || !input["owner"].is_string() || !input.contains("lease") || !input["lease"].is_string() ||
+          !input.contains("stream") || !input["stream"].is_number_unsigned()) throw std::invalid_argument("binding");
+      cliprelay::privacy::binding session {input["owner"].get<std::string>(), input["lease"].get<std::string>(), input["stream"].get<std::uint64_t>()};
+      if (!cliprelay::privacy::valid(session)) throw std::invalid_argument("binding");
+      cliprelay::privacy::process_identity worker;
+      if (op == "prepare") {
+        const auto &value = input.at("worker");
+        if (!value.is_object() || value.size() != 4 || !value.contains("pid") || !value["pid"].is_number_unsigned() ||
+            value["pid"].get<std::uint64_t>() > INT_MAX || !value.contains("birthSec") || !value["birthSec"].is_number_unsigned() ||
+            value["birthSec"].get<std::uint64_t>() >= (1ULL << 53) || !value.contains("birthUsec") || !value["birthUsec"].is_number_unsigned() ||
+            value["birthUsec"].get<std::uint64_t>() >= 1000000 || !value.contains("windows") || !value["windows"].is_array() ||
+            value["windows"].empty() || value["windows"].size() > 16) throw std::invalid_argument("worker");
+        worker.pid = value["pid"].get<int>(); worker.birth_sec = value["birthSec"].get<std::uint64_t>(); worker.birth_usec = value["birthUsec"].get<std::uint32_t>();
+        for (const auto &item : value["windows"]) {
+          if (!item.is_object() || item.size() != 2 || !item.contains("id") || !item["id"].is_number_unsigned() ||
+              item["id"].get<std::uint64_t>() > UINT32_MAX || !item.contains("display") || !item["display"].is_number_unsigned() ||
+              item["display"].get<std::uint64_t>() > UINT32_MAX) throw std::invalid_argument("window");
+          worker.windows.push_back({item["id"].get<std::uint32_t>(), item["display"].get<std::uint32_t>()});
+        }
+        std::sort(worker.windows.begin(), worker.windows.end(), [](const auto &a, const auto &b) { return a.id < b.id; });
+        if (!cliprelay::privacy::valid(worker)) throw std::invalid_argument("worker");
+      }
+      std::string outcome = "stale_instance";
+      if (input["instance"].get<std::string>() == cliprelayInstance()) {
+        if (op == "prepare") outcome = cliprelay::privacy::prepare_native(session, worker);
+        else if (op == "renew") outcome = cliprelay::privacy::renew_native(session);
+        else if (op == "release") outcome = cliprelay::privacy::release_native(session);
+        else outcome = cliprelay::privacy::native_state().session == session ? "status" : "stale";
+      }
+      send_response(response, cliprelayPrivacyState(outcome));
+    } catch (const std::exception &) {
+      bad_request(response, request, "Invalid privacy request");
+    }
+  }
+#endif
