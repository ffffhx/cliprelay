+static bool sendInputPacket(PPACKET_HOLDER holder, bool moreData) {
+    int result;
+    unsigned char bytes[16 + MAX_INPUT_PACKET_SIZE];
+    PltLockMutex(&cliprelayInputEpochMutex);
+    if (!cliprelayInputEpochActive) {
+        PltUnlockMutex(&cliprelayInputEpochMutex);
+        return sendInputPacketLegacy(holder, moreData);
+    }
+    if (!cliprelayInputCurrentLocked(holder)) {
+        PltUnlockMutex(&cliprelayInputEpochMutex);
+        return true;
+    }
+    const size_t length = PACKET_SIZE(holder);
+    if (length > MAX_INPUT_PACKET_SIZE || length < sizeof(NV_INPUT_HEADER)) {
+        PltUnlockMutex(&cliprelayInputEpochMutex);
+        return false;
+    }
+    cliprelayInputHeader(bytes, holder->cliprelayEpoch, 3, length);
+    memcpy(bytes + 16, &holder->packet, length);
+    result = sendInputPacketOnControlStream(bytes, (int)(16 + length), holder->channelId, holder->enetPacketFlags, moreData);
+    if (result < 0) {
+        PltLockMutex(&batchedInputMutex);
+        cliprelayInputEpochFailed = true;
+        cliprelayInputEpochOpen = false;
+        PltUnlockMutex(&batchedInputMutex);
+    }
+    PltUnlockMutex(&cliprelayInputEpochMutex);
+    if (result < 0) ListenerCallbacks.connectionTerminated(result);
+    return result >= 0;
+}
