+static void cliprelayInputHeader(unsigned char* bytes, uint32_t epoch, unsigned operation, size_t bodyLength) {
+    uint32_t length = BE32((uint32_t)(12 + bodyLength));
+    uint32_t magic = LE32(0x4352494e);
